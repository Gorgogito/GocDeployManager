<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Rutas relativas a la carpeta del ejecutable (sección 16 del análisis). -->
    <add key="RutaClonado" value=".\Data\Clonado" />
    <add key="RutaTemporales" value=".\Data\Temp" />
    <add key="RutaLogs" value=".\Data\Logs" />
    <add key="RutaConfiguracion" value=".\Data\Config" />
    <!-- Base de datos SQL Server (usuarios e historial) — ejecutar antes
         sql/schema-sql-server.sql contra esta base. Ver docs/manual-usuario.html. -->
    <add key="CadenaConexionSqlServer" value="Server=.\SQLEXPRESS;Database=GocDeployManager;Integrated Security=true;TrustServerCertificate=true;" />
    <!-- Fija: instalación estandarizada de Visual Studio (confirmado con el cliente). -->
    <add key="RutaMsBuildExe" value="C:\Windows\Microsoft.NET\Framework64\v4.0.30319\MSBuild.exe" />
    <!-- Se resuelve por PATH: Git garantizado en toda máquina (confirmado con el cliente). -->
    <add key="RutaGitExe" value="git.exe" />
  </appSettings>
</configuration>
