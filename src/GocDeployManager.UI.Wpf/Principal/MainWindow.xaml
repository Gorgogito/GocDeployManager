<ventanas:VentanaBase x:Class="GocDeployManager.UI.Principal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ventanas="clr-namespace:GocDeployManager.UI.Ventanas"
        xmlns:local="clr-namespace:GocDeployManager.UI.Principal"
        Width="900" Height="560"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="0"
                      GlassFrameThickness="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ BARRA DE TÍTULO ══════════════ -->
        <Grid Grid.Row="0"
              Background="{DynamicResource PrimaryHueMidBrush}"
              MouseDown="TitleBar_MouseDown">
            <TextBlock x:Name="lblTituloVentana"
                       Text="GocDeployManager"
                       VerticalAlignment="Center" Margin="14,0"
                       Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                       FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Click="MinimizeButton_Click"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Width="46" Height="36" Padding="0">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Click="MaximizeButton_Click"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Width="46" Height="36" Padding="0">
                    <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                </Button>
                <Button Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Click="CloseButton_Click"
                        Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                        Width="46" Height="36" Padding="0">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════ CONTENIDO PRINCIPAL ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEMENU ── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado: app + usuario -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            Padding="16,14,16,12">
                        <StackPanel>
                            <TextBlock Text="GocDeployManager"
                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                       FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="lblUsuarioSide"
                                       Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                       FontSize="11" Opacity="0.80"/>
                        </StackPanel>
                    </Border>

                    <!-- Items de navegación -->
                    <ListBox Grid.Row="1" x:Name="lstSideMenu"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,6,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="46"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="20,0,16,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="Principal"     Tag="principal"/>
                        <ListBoxItem Content="Configuración" Tag="configuracion"/>
                        <ListBoxItem Content="Historial"     Tag="historial"/>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── ÁREA CENTRAL ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                    <RowDefinition Height="Auto"/>  <!-- Error -->
                    <RowDefinition Height="Auto"/>  <!-- Sistemas -->
                    <RowDefinition Height="Auto"/>  <!-- Progreso -->
                    <RowDefinition Height="*"/>     <!-- Log -->
                    <RowDefinition Height="Auto"/>  <!-- StatusBar -->
                </Grid.RowDefinitions>

                <!-- Toolbar equivalente al RibbonBar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        Padding="14,9">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GOC" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12"/>
                        <TextBox x:Name="txtGoc" Width="130" Margin="0,0,16,0"
                                 materialDesign:HintAssist.Hint="GOC-00000"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Ambiente" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12"/>
                        <ComboBox x:Name="comboAmbiente" Width="160" Margin="0,0,16,0"
                                  DisplayMemberPath="Nombre"
                                  VerticalAlignment="Center"/>
                        <Button x:Name="btnIniciarDespliegue"
                                Content="Iniciar despliegue"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,16,0"
                                Click="BtnIniciarDespliegue_Click"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Tema" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="12"/>
                        <ComboBox x:Name="comboTema" Width="90" VerticalAlignment="Center">
                            <ComboBoxItem Content="Claro"/>
                            <ComboBoxItem Content="Oscuro"/>
                        </ComboBox>
                    </WrapPanel>
                </Border>

                <!-- Error de validación -->
                <TextBlock Grid.Row="1" x:Name="lblError"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                           Padding="16,4" Visibility="Collapsed" FontSize="12"/>

                <!-- Sistemas afectados -->
                <Border Grid.Row="2" Margin="8,6,8,0"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="SISTEMAS AFECTADOS"
                                   Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="panelSistemas" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

                <!-- Progreso del despliegue -->
                <Border Grid.Row="3" Margin="8,6,8,0"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="PROGRESO DEL DESPLIEGUE"
                                   Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="lblEtapaActual"
                                   Text="Sin despliegues en curso."
                                   FontSize="12" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="barraProgreso" Height="6"
                                     Value="0" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- Log de salida del despliegue -->
                <Border Grid.Row="4" Margin="8,6,8,4"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1" CornerRadius="4"
                        ClipToBounds="True">
                    <ListView x:Name="logListView"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              BorderThickness="0"
                              FontFamily="Consolas" FontSize="11">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="{Binding CorFondo}"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Hora" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type local:LogItem}">
                                            <TextBlock Text="{Binding Hora}"
                                                       Foreground="{Binding CorTexto}"
                                                       Padding="4,2"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Mensaje" Width="2000">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type local:LogItem}">
                                            <TextBlock Text="{Binding Mensaje}"
                                                       Foreground="{Binding CorTexto}"
                                                       FontWeight="{Binding PesoFuente}"
                                                       Padding="4,2"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- StatusBar -->
                <StatusBar Grid.Row="5"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           BorderBrush="{DynamicResource MaterialDesignDivider}"
                           BorderThickness="0,1,0,0" Height="26">
                    <StatusBar.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </StatusBar.ItemsPanel>
                    <StatusBarItem Grid.Column="0" Padding="10,0">
                        <TextBlock x:Name="lblStatusIzquierda" Text="Listo."
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StatusBarItem>
                    <StatusBarItem Grid.Column="1" Padding="10,0">
                        <TextBlock x:Name="lblStatusDerecha" FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>

            <!-- Overlay de carga — cubre el área central durante el despliegue -->
            <Grid Grid.Column="1" x:Name="overlayGrid"
                  Visibility="Collapsed" Panel.ZIndex="100">
                <Border Background="#B0000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="240" Height="4" Margin="0,0,0,20"/>
                        <TextBlock x:Name="lblOverlay" Text="Desplegando..."
                                   Foreground="White" FontSize="15"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Snackbar para notificaciones de resultado -->
        <materialDesign:Snackbar Grid.Row="1" x:Name="snackbar"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Panel.ZIndex="200"/>
    </Grid>
</ventanas:VentanaBase>
